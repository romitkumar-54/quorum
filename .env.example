# Quorum runs with none of these set — the voice layer falls back to the
# browser's own speech engine and the header reads "simulated".
#
# Fill them in to switch the audio path to Agora Conversational AI. Copy this
# file to .env.local, which is gitignored. Never commit real values.

# ── Agora Conversational AI ─────────────────────────────────────────────────
# console.agora.io → your project. The customer ID and secret are the RESTful
# API credentials, not the app certificate.
AGORA_APP_ID=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Channel token. Leave blank while the project is in testing mode.
AGORA_RTC_TOKEN=

# ── The interviewers' brains ────────────────────────────────────────────────
# One call per granted floor: the coordinator picks who speaks, and the model
# writes that interviewer's line from its persona, the shared brief, and the
# flag it won the floor on. Without a key the deterministic ScriptedGenerator
# drives every question and the header reads "scripted".
#
# The rehearsed demo always uses the scripted panel, key or no key, so it plays
# identically every time. Any error or timeout falls back to it silently.
LLM_API_KEY=
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
# Reasoning models bill hidden thinking against the token budget. Groq's gpt-oss
# accepts low/medium/high; leave blank for providers that reject the field.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=

# ── Three distinct voices ───────────────────────────────────────────────────
# Microsoft TTS through Agora. Voice per role is set in src/app/api/agent/route.ts.
TTS_KEY=
TTS_REGION=eastus
